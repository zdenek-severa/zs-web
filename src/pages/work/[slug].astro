---
import Layout from '../../layouts/Layout.astro';
import Slideshow from '../../components/Slideshow';
import { projects } from '../../data/projects';
import { absoluteUrl } from '../../lib/seo';
export function getStaticPaths() { return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, next: projects[(index + 1) % projects.length] } })); }
const { project, next } = Astro.props;
const slides = project.images.map(src => ({ src, title: project.name, subtitle: project.category }));
const projectUrl = absoluteUrl(`/work/${project.slug}/`);
const structuredData = [
  { '@type': 'CreativeWork', '@id': `${projectUrl}#project`, url: projectUrl, name: project.name, description: project.description, image: project.images.map(absoluteUrl), inLanguage: 'cs-CZ', mainEntityOfPage: { '@id': `${projectUrl}#webpage` } },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Projekty', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: project.name, item: projectUrl },
  ] },
];
---
<Layout title={`${project.name} — ${project.category.split(' · ')[1]} | Zdeněk Severa`} description={project.description} image={project.images[0]} imageAlt={`${project.name} — architektonická vizualizace`} structuredData={structuredData} overlay active="work">
  <Slideshow slides={slides} heading={project.name} project client:load />
  <section class="project-intro" id="project"><div><a class="text-link back-link" href="/#work">← Všechny projekty</a><dl><div><dt>Projekt</dt><dd>{project.name}</dd></div><div><dt>Zaměření</dt><dd>{project.category.split(' · ')[1]}</dd></div><div><dt>Rok vizualizace</dt><dd>{project.year}</dd></div></dl></div><div><span class="eyebrow">{project.category}</span><h2>{project.headline}</h2><p>{project.description}</p></div></section>
  <section class="project-gallery" aria-label={`Galerie projektu ${project.name}`}>
    {project.images.map((src, i) => <figure class:list={{ 'gallery-wide': i === 0 || i === project.images.length - 1 }}><img src={src} alt={`${project.name} — pohled ${i + 1}`} loading="lazy" decoding="async" width="1800" height="1200" /><figcaption><span>{project.name}</span><span>{String(i + 1).padStart(2, '0')}</span></figcaption></figure>)}
  </section>
  <a class="next-project" href={`/work/${next.slug}/`}><img src={next.images[0]} alt="" loading="lazy" /><div><span class="eyebrow">Další projekt</span><h2>{next.name}<span aria-hidden="true">↗</span></h2></div></a>
</Layout>
