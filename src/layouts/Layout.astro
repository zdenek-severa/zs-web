---
import '../styles/global.css';
import { absoluteUrl, indexable, person, site } from '../lib/seo';
interface Props {
  title?: string; description?: string; overlay?: boolean; active?: string; image?: string;
  imageAlt?: string; noindex?: boolean; pageType?: string; structuredData?: Record<string, unknown>[];
}
const {
  title = 'Zdeněk Severa — architektonické návrhy a vizualizace',
  description = 'Portfolio Zdeňka Severy: architektonické návrhy, interiéry a vizualizace. Prohlédněte si projekty bydlení, veřejných staveb i firemních sídel.',
  overlay = false, active = '', image = '/images/mikulcin-vrch/01.webp',
  imageAlt = 'Mikulčin vrch — architektonická vizualizace', noindex = false, pageType = 'WebPage', structuredData = [],
} = Astro.props;
const canonical = absoluteUrl(Astro.url.pathname);
const canIndex = indexable && !noindex;
const graph = [
  person,
  { '@type': 'WebSite', '@id': absoluteUrl('/#website'), url: site.url, name: 'Zdeněk Severa — architektura a vizualizace', inLanguage: 'cs-CZ', publisher: { '@id': person['@id'] } },
  { '@type': pageType, '@id': `${canonical}#webpage`, url: canonical, name: title, description, inLanguage: 'cs-CZ', isPartOf: { '@id': absoluteUrl('/#website') }, ...(pageType === 'AboutPage' ? { mainEntity: { '@id': person['@id'] } } : {}) },
  ...structuredData,
];
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={canIndex ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
    <meta name="author" content="Zdeněk Severa" />
    {site.configured && !noindex && <link rel="canonical" href={canonical} />}
    {verification && <meta name="google-site-verification" content={verification} />}
    <meta name="theme-color" content="#f4f3ef" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Zdeněk Severa" />
    <meta property="og:locale" content="cs_CZ" />
    {site.configured && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={absoluteUrl(image)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl(image)} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="preconnect" href="https://mcleanquinlan.com" crossorigin />
    {overlay && <link rel="preload" as="image" href={image} fetchpriority="high" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {site.configured && !noindex && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')} />}
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Přejít na obsah</a>
    <header class:list={['site-header', { 'site-header--overlay': overlay }]}>
      <a class="wordmark" href="/" aria-label="Zdenek Severa — úvod">Zdenek Severa<span>Architektura &amp; vizualizace</span></a>
      <nav aria-label="Hlavní navigace">
        <a href="/#work" aria-current={active === 'work' ? 'page' : undefined}>work</a>
        <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>about</a>
        <a href="/contact/" aria-current={active === 'contact' ? 'page' : undefined}>contact</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-middle"><a class="footer-name" href="/">Zdenek Severa</a><div><a href="mailto:zdenek.severa@gmail.com">zdenek.severa@gmail.com</a><a href="tel:+420724955557">+420&nbsp;724&nbsp;955&nbsp;557</a></div><nav aria-label="Navigace v patičce"><a href="/#work">work</a><a href="/about/">about</a><a href="/contact/">contact</a></nav></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Zdeněk Severa</span><span>IČO 03108040</span><a href="#top" data-top>Zpět nahoru ↑</a></div>
    </footer>
    <script>
      document.querySelector('[data-top]')?.addEventListener('click', event => { event.preventDefault(); window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' }); });
    </script>
  </body>
</html>
